# Groq Cloud API Key (Get a free API key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Model name: whisper-large-v3-turbo (recommended, fastest & highest quality)
GROQ_MODEL=whisper-large-v3-turbo

# Primary language: vi (Vietnamese) or en (English)
LANGUAGE=vi

# Activation Key: Right Ctrl (ctrl_r)
HOTKEY=ctrl_r

# Audio Recording Settings
SAMPLE_RATE=16000
MIN_DURATION_SECONDS=0.3
