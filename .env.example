# Groq Cloud API Key (Get a free API key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Model name: whisper-large-v3-turbo (recommended, fastest & highest quality)
GROQ_MODEL=whisper-large-v3-turbo

# Primary language: vi (Vietnamese), en (English), or auto (omit language hint)
LANGUAGE=vi

# Activation Key: Right Ctrl (ctrl_r)
HOTKEY=ctrl_r

# Audio Recording Settings
SAMPLE_RATE=16000
MIN_DURATION_SECONDS=0.3

# Reject near-silence before uploading. Calibrate on the actual microphone.
SILENCE_THRESHOLD_DBFS=-60

# Show raw/cleaned transcripts on the local console only when troubleshooting.
DEBUG_TRANSCRIPT=0
